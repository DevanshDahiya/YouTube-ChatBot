# ollama (local, default) or gemini (hosted)
LLM_PROVIDER=ollama

# Only needed when LLM_PROVIDER=gemini. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional overrides
# GEMINI_CHAT_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite   # empty = no fallback
# GEMINI_EMBED_MODEL=models/gemini-embedding-001
# DATA_DIR=./data

# Deployed server only: the extension must send this same value (see extension/config.js).
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
# API_KEY=
