
# LLM: openai | google | anthropic
LLM_PROVIDER=
# Embeddings: openai | google | local   (anthropic has no embeddings model -> use local)
EMBEDDING_PROVIDER=
# Optional overrides (leave empty for defaults in app/providers.py)
LLM_MODEL=
EMBEDDING_MODEL=

OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

CHROMA_DIR=./data/chroma
CACHE_DB=./data/cache.sqlite

CHUNK_WINDOW_SECONDS=75
CHUNK_OVERLAP_SECONDS=15
TRANSCRIPT_LANGUAGES=en,en-US,en-GB,hi
RETRIEVAL_K=5