{
    "manifest_version": 3,
    "name": "YouTube ChatBot",
    "version" : "0.1.0" ,
    "description" : "Ask questions about a YouTube video and jump to the exact moment.",
    "content_scripts" : [
        {
            "matches" : ["https://www.youtube.com/*"],
            "js" : ["sidebar.js","content.js"],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources" : ["sidebar.css"],
            "matches" :["https://www.youtube.com/*"]
        }
    ]
}